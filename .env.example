# Copiá este archivo como .env.local para probar en tu compu,
# y cargá las mismas variables en Vercel → Settings → Environment Variables.

# Supabase (proyecto "casa-3d"). La service role key está en Supabase → Project Settings → API.
# Es secreta: nunca la pongas en el código ni en variables que empiecen con VITE_.
SUPABASE_URL=https://ysdwgvrwkshjxdpjgpvs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Código del teclado del baño (el de todos los días) y código de alta (para registrar un celu o PC nuevo)
OWNER_CODE=
OWNER_SETUP_CODE=

# Firma de la sesión de dueño: cualquier texto largo y al azar (mínimo 32 caracteres)
SESSION_SECRET=

# Dominio donde vas a usar la huella. Las passkeys quedan atadas a este dominio.
# Ej: casa-3d-sebas.vercel.app  (en local dejalo vacío)
RP_ID=

# Opcional: sube el límite de la API de GitHub
GITHUB_TOKEN=

# Solo para probar en local sin Supabase: base en memoria
# CASA_MEMORY_DB=1

# Opcional: de dónde salen los proyectos (por defecto, el projects.json de la porta)
# VITE_PROJECTS_URL=https://juansebastianfernandez-dev.vercel.app/data/projects.json
